# ============================================================
# SoundProof — Production Environment Variables
# Copy this file to /etc/voicecheck/.env on your EC2 instance
# Fill in every value before running deploy.sh
# NEVER commit .env to git
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=SoundProof API
APP_VERSION=1.0.0
DEBUG=false
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS — your frontend URLs (comma-separated) ──────────────
CORS_ORIGINS=https://voice-profile-two.vercel.app,https://www.soundproof.app

# ── Database — keep pointing at Supabase (no migration needed) ──
# Paste your Supabase connection string (Session mode, port 5432)
# From: Supabase dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Storage — use S3 in production ───────────────────────────
STORAGE_BACKEND=s3

# ── AWS / S3 ──────────────────────────────────────────────────
# Create an IAM user with the policy below (s3:HeadObject is NOT a valid IAM
# action — HeadObject calls are authorized by s3:GetObject):
#   Actions on arn:aws:s3:::voicecheck-uploads/*  → s3:PutObject, s3:GetObject, s3:DeleteObject
#   Actions on arn:aws:s3:::voicecheck-uploads     → s3:ListBucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=voicecheck-uploads
S3_PRESIGN_EXPIRY=3600
S3_OBJECT_TTL_HOURS=24

# ── Transcription ─────────────────────────────────────────────
TRANSCRIPTION_BACKEND=openai_api
OPENAI_API_KEY=sk-...

# ── Auth (Clerk) ──────────────────────────────────────────────
AUTH_REQUIRED=true
CLERK_ISSUER=https://clerk.[your-app].accounts.dev
CLERK_JWKS_URL=https://clerk.[your-app].accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_...

# ── Billing (bSecure / Payoneer manual flow) ──────────────────
BSECURE_CLIENT_ID=
BSECURE_CLIENT_SECRET=
BSECURE_STORE_SLUG=
BSECURE_CALLBACK_URL=https://YOUR_DOMAIN/api/billing/bsecure-webhook
BSECURE_STARTER_AMOUNT=2000
BSECURE_PRO_AMOUNT=4000

# ── Stripe (if switching from bSecure) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=SoundProof <noreply@soundproof.app>

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAILS=your@email.com
ADMIN_CLERK_IDS=user_...

# ── Plan limits (defaults match usage_service.py) ────────────
# Override here if you want to change limits without a redeploy
# (Leave empty to use code defaults)
# FREE_TRIAL_MAX_FILE_MINUTES=15
# STARTER_MINUTES=300
# PRO_MINUTES=1000
