# ─── Transcription ──────────────────────────────
# Production: openai_api (server-side; users never provide a key).
# Dev/offline: faster_whisper (zero-cost local fallback).
TRANSCRIPTION_BACKEND=openai_api

# REQUIRED when TRANSCRIPTION_BACKEND=openai_api.
# Set on the server only — never exposed to the browser.
OPENAI_API_KEY=sk-proj-...

# Whisper model size (only used when TRANSCRIPTION_BACKEND=faster_whisper)
# tiny=fastest, base=balanced, small=better, medium=best CPU option
WHISPER_MODEL_SIZE=base

# ─── App ────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────
# Dev: local SQLite. Production: postgresql+asyncpg://user:pass@host/db
# (Supabase: copy "Connection string -> URI" from project settings, swap
#  prefix to postgresql+asyncpg://, URL-encode special chars in password)
DATABASE_URL=sqlite+aiosqlite:///./voicecheck.db

# ─── Auth (Clerk) ───────────────────────────────
# Backend verifies Clerk JWTs against Clerk's JWKS. Server-side only.
# CLERK_ISSUER is your Clerk Frontend API URL, e.g.:
#   https://your-app.clerk.accounts.dev   (development)
#   https://clerk.your-domain.com         (production)
CLERK_ISSUER=
# Optional: explicit JWKS URL. If empty, derived from CLERK_ISSUER.
CLERK_JWKS_URL=

# Set to true ONLY after Clerk creds are wired and the frontend is sending
# Authorization: Bearer <jwt>. Stays false in dev so existing tests pass.
AUTH_REQUIRED=false

# ─── Billing (Stripe) ───────────────────────────
# Server-side keys only — never expose to the browser.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs for each tier (create PRICES, not products, in Stripe
# Dashboard — these must start with "price_", not "prod_")
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ─── Frontend ───────────────────────────────────
VITE_API_URL=http://localhost:8000/api
# Clerk publishable key — pk_test_... in dev, pk_live_... in prod.
# When EMPTY, the frontend runs in dev mode (no auth required) which
# matches the backend's AUTH_REQUIRED=false default.
VITE_CLERK_PUBLISHABLE_KEY=
